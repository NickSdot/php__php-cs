#!/usr/bin/env bash

set -Eeuo pipefail

COMMIT_SUFFIX="applied fixers to improve test robustness"
DEFAULT_PR_TITLE="Apply fixers to improve test robustness"
DEFAULT_PR_REPO="php/php-src"
DEFAULT_PHP_SRC_DIR="../php__php-src"
# Extraction PRs that cannot be discovered from their title or container-PR link.
ADDITIONAL_EXTRACTION_PRS=(23179)

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

PHP_SRC_DIR="${PHP_SRC_DIR:-}"
PR_NUMBER=""
PR_REPO=""
EXISTING_PR_BASE_NAME=""
RESOLVED_BASE_REF=""
RESOLVED_BASE_NAME=""
PUSH_REMOTE=""
LFG=0
RESET=0
DRY=0
NO_RUN=0
SKIP_NORMALIZATION_ONLY=0
TARGET_ARGS=()
WORKTREE_ROOT=""
PARALLEL_RUN_COMPLETE=0

cleanup_parallel_worktrees() {
    [[ -n "$WORKTREE_ROOT" && -d "$WORKTREE_ROOT" ]] || return 0

    local worktree
    if [[ -d "$WORKTREE_ROOT/worktrees" ]]; then
        while IFS= read -r worktree; do
            [[ -n "$worktree" ]] || continue
            git -C "$PHP_SRC_DIR" worktree remove --force "$worktree" >/dev/null 2>&1 || true
        done < <(find "$WORKTREE_ROOT/worktrees" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    fi

    if (( PARALLEL_RUN_COMPLETE )); then
        rm -rf "$WORKTREE_ROOT"
    else
        printf '\nParallel run state preserved after failure: %s\n' "$WORKTREE_ROOT" >&2
    fi
}

trap cleanup_parallel_worktrees EXIT

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  bin/contribute [options] [target ...]

Runs all php-src-cs fixers target-by-target for php-src PRs. Each changed target
gets one commit:

  ext/intl: applied fixers to improve test robustness

Options:
  --php-src-dir DIR  php-src checkout. Default: $PHP_SRC_DIR or ../php__php-src.
  --no-run           Use existing generated commits at HEAD.
  --skip-normalization-only
                     Skip PHPTs changed only by catch-type, quote, or newline normalization.
  --lfg              Push and update the PR body, or create a draft PR.
  --nah              Reset contiguous generated commits at HEAD.
  --dry              Preview only.
  -h, --help         Show this help.

Targets are php-src paths such as ext/intl, Zend, tests, or sapi/cli.
No target means ext/*, Zend, tests, and sapi/*.

Every run confirms the php-src branch first. Normal runs require a clean tracked
php-src working tree.

Multiple targets run in parallel in isolated worktrees. Commits are still created
serially in target order.

If the current branch has no open PR, --lfg creates a draft PR. In that case the
base branch is selected interactively when it cannot be inferred.

PR updates replace only the tables between:
  <!-- pr:targets:start -->
  <!-- pr:targets:end -->
USAGE
}

main() {
    parse_args "$@"
    resolve_container_pr_from_environment
    resolve_php_src_dir
    require_php_src_checkout
    confirm_current_branch

    if (( RESET )); then
        (( ! NO_RUN )) || die '--nah cannot be combined with --no-run'
        reset_generated_commits
        after_local_changes reset
        return
    fi

    if (( NO_RUN )); then
        (( ${#TARGET_ARGS[@]} == 0 )) || die '--no-run cannot be combined with target arguments'
        ensure_tracked_clean
        after_local_changes run
        return
    fi

    local targets=()
    local target

    while IFS= read -r target; do
        [[ -n "$target" ]] && targets+=("$target")
    done < <(target_list)

    ensure_tracked_clean

    run_targets "${targets[@]}"

    after_local_changes run
}

parse_args() {
    while (($#)); do
        case "$1" in
            --php-src-dir)
                shift
                (($#)) || die '--php-src-dir requires a value'
                PHP_SRC_DIR="$1"
                ;;
            --php-src-dir=*)
                PHP_SRC_DIR="${1#--php-src-dir=}"
                ;;
            --nah)
                RESET=1
                ;;
            --no-run)
                NO_RUN=1
                ;;
            --skip-normalization-only)
                SKIP_NORMALIZATION_ONLY=1
                ;;
            --lfg)
                LFG=1
                ;;
            --dry)
                DRY=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                while (($#)); do
                    TARGET_ARGS+=("$1")
                    shift
                done
                ;;
            -*)
                die "unknown option: $1"
                ;;
            *)
                TARGET_ARGS+=("$1")
                ;;
        esac
        shift || true
    done
}

resolve_container_pr_from_environment() {
    if [[ -n "$PR_NUMBER" || -n "$PR_REPO" ]]; then
        return
    fi

    if [[ -z "${PHP_SRC_PR:-}" && -z "${PHP_SRC_REPO:-}" ]]; then
        return
    fi

    local repo="${PHP_SRC_REPO:-$DEFAULT_PR_REPO}"
    local number="${PHP_SRC_PR:-}"

    [[ -n "$number" ]] \
        || die 'PHP_SRC_REPO is set but PHP_SRC_PR is missing'
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
        || die "invalid PHP_SRC_REPO: $repo"
    [[ "$number" =~ ^[1-9][0-9]*$ ]] \
        || die "invalid PHP_SRC_PR: $number"

    PR_REPO="$repo"
    PR_NUMBER="$number"
}

resolve_php_src_dir() {
    if [[ -z "$PHP_SRC_DIR" ]]; then
        PHP_SRC_DIR="$TOOL_ROOT/$DEFAULT_PHP_SRC_DIR"
    fi

    PHP_SRC_DIR="$(cd -- "$PHP_SRC_DIR" && pwd)" || die "cannot resolve php-src dir: $PHP_SRC_DIR"
}

require_php_src_checkout() {
    git -C "$PHP_SRC_DIR" rev-parse --show-toplevel >/dev/null 2>&1 \
        || die "not a Git checkout: $PHP_SRC_DIR"

    [[ -f "$PHP_SRC_DIR/run-tests.php" ]] \
        || die "does not look like php-src; missing run-tests.php: $PHP_SRC_DIR"

    [[ -f "$TOOL_ROOT/bin/php-src-cs.php" ]] \
        || die "missing php-src-cs command: $TOOL_ROOT/bin/php-src-cs.php"
}

confirm_current_branch() {
    local branch
    branch="$(git -C "$PHP_SRC_DIR" branch --show-current)"
    [[ -n "$branch" ]] || die 'php-src checkout is detached; refusing to continue'

    printf 'php-src checkout: %s\n' "$PHP_SRC_DIR"
    printf 'current branch:   %s\n' "$branch"
    printf 'Run on this branch? [y/N]: '

    local answer
    IFS= read -r answer || die 'branch confirmation cancelled'

    case "$answer" in
        y|Y|yes|YES)
            ;;
        *)
            die 'branch not confirmed'
            ;;
    esac
}

ensure_tracked_clean() {
    local dirty
    dirty="$(git -C "$PHP_SRC_DIR" status --porcelain --untracked-files=no)"
    [[ -z "$dirty" ]] || {
        printf '%s\n' "$dirty" >&2
        die 'php-src has tracked changes; commit/stash/reset them first'
    }
}

target_list() {
    if ((${#TARGET_ARGS[@]})); then
        local target
        for target in "${TARGET_ARGS[@]}"; do
            normalise_target "$target"
        done
        return
    fi

    discover_default_targets
}

discover_default_targets() {
    local dir

    if [[ -d "$PHP_SRC_DIR/ext" ]]; then
        while IFS= read -r dir; do
            printf 'ext/%s\n' "$(basename -- "$dir")"
        done < <(find "$PHP_SRC_DIR/ext" -mindepth 1 -maxdepth 1 -type d | sort)
    fi

    [[ -d "$PHP_SRC_DIR/Zend" ]] && printf 'Zend\n'
    [[ -d "$PHP_SRC_DIR/tests" ]] && printf 'tests\n'

    if [[ -d "$PHP_SRC_DIR/sapi" ]]; then
        while IFS= read -r dir; do
            printf 'sapi/%s\n' "$(basename -- "$dir")"
        done < <(find "$PHP_SRC_DIR/sapi" -mindepth 1 -maxdepth 1 -type d | sort)
    fi
}

normalise_target() {
    local target="$1"

    if [[ "$target" == "$PHP_SRC_DIR/"* ]]; then
        target="${target#"$PHP_SRC_DIR/"}"
    fi

    target="${target#./}"
    target="${target%/}"

    [[ -e "$PHP_SRC_DIR/$target" ]] || die "target does not exist in php-src: $target"
    printf '%s\n' "$target"
}

run_targets() {
    if (($# == 0)); then
        return
    fi

    if (($# == 1)); then
        run_target "$1"
        return
    fi

    run_targets_parallel "$@"
}

run_target() {
    local target="$1"
    local subject="$target: $COMMIT_SUFFIX"

    printf '\n==> %s\n' "$target"
    run_fixers "$PHP_SRC_DIR" "$target"

    if ! has_tracked_changes; then
        printf 'No tracked changes for %s; no commit created.\n' "$target"
        return
    fi

    ensure_changes_are_within_target "$target"

    git -C "$PHP_SRC_DIR" add -u -- "$target"

    if git -C "$PHP_SRC_DIR" diff --cached --quiet; then
        printf 'No staged changes for %s; no commit created.\n' "$target"
        return
    fi

    git -C "$PHP_SRC_DIR" commit -m "$subject"
}

run_targets_parallel() {
    local targets=("$@")
    local target_count="${#targets[@]}"
    local jobs
    local base
    local index=0
    local target
    local slug
    local worktree
    local pids=()
    local failed=0

    jobs="$(parallel_jobs)"
    base="$(git -C "$PHP_SRC_DIR" rev-parse HEAD)"
    WORKTREE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/php-src-cs-contribute.XXXXXX")"
    mkdir -p "$WORKTREE_ROOT/worktrees" "$WORKTREE_ROOT/logs" "$WORKTREE_ROOT/patches" "$WORKTREE_ROOT/results"

    configure_test_runtime_for_parallel

    printf '\nRunning %d targets in parallel with %d jobs.\n' "$target_count" "$jobs"

    for target in "${targets[@]}"; do
        index=$((index + 1))
        slug="$(target_slug "$index" "$target")"
        worktree="$WORKTREE_ROOT/worktrees/$slug"

        while (( "$(running_parallel_jobs)" >= jobs )); do
            sleep 0.2
        done

        run_target_worker \
            "$target" \
            "$worktree" \
            "$WORKTREE_ROOT/results/$slug" \
            "$WORKTREE_ROOT/patches/$slug.patch" \
            "$WORKTREE_ROOT/logs/$slug.log" \
            "$base" &
        pids+=("$!")
    done

    for pid in "${pids[@]}"; do
        if ! wait "$pid"; then
            failed=1
        fi
    done

    if (( failed )); then
        print_parallel_failures
        die 'one or more parallel target runs failed'
    fi

    apply_parallel_results "${targets[@]}"
    PARALLEL_RUN_COMPLETE=1
}

run_target_worker() {
    local target="$1"
    local worktree="$2"
    local result_file="$3"
    local patch_file="$4"
    local log_file="$5"
    local base="$6"
    local status='failed'
    local temporary_patch="$patch_file.tmp"

    printf 'Started %s\n' "$target"

    if ! git -C "$PHP_SRC_DIR" worktree add --detach "$worktree" "$base" > "$log_file" 2>&1; then
        fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file"
        return 1
    fi

    {
        print_fix_command "$worktree" "$target"
        run_fixers "$worktree" "$target"
    } >> "$log_file" 2>&1 || {
        fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file"
        return 1
    }

    if ! ensure_changes_are_within_target_in_dir "$worktree" "$target" >> "$log_file" 2>&1; then
        fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file"
        return 1
    fi

    if git -C "$worktree" diff --quiet -- "$target"; then
        status='nochange'
    else
        if ! git -C "$worktree" diff --binary --no-ext-diff --full-index -- "$target" > "$temporary_patch"; then
            fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file" \
                "Could not create patch for $target."
            return 1
        fi

        if [[ ! -s "$temporary_patch" ]]; then
            fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file" \
                "Generated patch for $target is empty despite a non-empty git diff."
            return 1
        fi

        if ! git -C "$PHP_SRC_DIR" apply --check --whitespace=nowarn "$temporary_patch" >> "$log_file" 2>&1; then
            fail_target_worker "$target" "$worktree" "$result_file" "$patch_file" "$log_file" \
                "Generated patch for $target does not apply to the parallel-run base."
            return 1
        fi

        mv "$temporary_patch" "$patch_file"
        status='changed'
    fi

    git -C "$PHP_SRC_DIR" worktree remove --force "$worktree" >/dev/null 2>&1 || true

    printf '%s\t%s\t%s\t%s\n' "$status" "$target" "$patch_file" "$log_file" > "$result_file"
    printf 'Finished %s (%s)\n' "$target" "$status"
}

run_fixers() {
    local php_src_dir="$1"
    local target="$2"
    local args=(fix --php-src-dir "$php_src_dir")

    if (( SKIP_NORMALIZATION_ONLY )); then
        args+=(--skip-normalization-only)
    fi

    args+=("$php_src_dir/$target")
    php "$TOOL_ROOT/bin/php-src-cs.php" "${args[@]}"
}

print_fix_command() {
    local php_src_dir="$1"
    local target="$2"
    local args=(fix --php-src-dir "$php_src_dir")

    if (( SKIP_NORMALIZATION_ONLY )); then
        args+=(--skip-normalization-only)
    fi

    args+=("$php_src_dir/$target")

    printf '$ php %q' "$TOOL_ROOT/bin/php-src-cs.php"
    printf ' %q' "${args[@]}"
    printf '\n'
}

fail_target_worker() {
    local target="$1"
    local worktree="$2"
    local result_file="$3"
    local patch_file="$4"
    local log_file="$5"
    local message="${6:-}"

    [[ -z "$message" ]] || printf '%s\n' "$message" >> "$log_file"
    git -C "$PHP_SRC_DIR" worktree remove --force "$worktree" >/dev/null 2>&1 || true
    printf 'failed\t%s\t%s\t%s\n' "$target" "$patch_file" "$log_file" > "$result_file"
    printf 'Failed %s\n' "$target"
}

apply_parallel_results() {
    local index=0
    local target
    local slug
    local result_file
    local status
    local result_target
    local patch_file
    local log_file
    local subject

    ensure_tracked_clean

    for target in "$@"; do
        index=$((index + 1))
        slug="$(target_slug "$index" "$target")"
        result_file="$WORKTREE_ROOT/results/$slug"

        IFS=$'\t' read -r status result_target patch_file log_file < "$result_file"
        [[ "$result_target" == "$target" ]] || die "parallel result target mismatch: expected $target, got $result_target"

        printf '\n==> %s\n' "$target"

        if [[ "$status" == nochange ]]; then
            printf 'No tracked changes for %s; no commit created.\n' "$target"
            continue
        fi

        [[ "$status" == changed ]] || die "unexpected parallel target status for $target: $status"

        cat "$log_file"
        [[ -s "$patch_file" ]] || die "parallel patch for $target is empty: $patch_file"
        git -C "$PHP_SRC_DIR" apply --check --index --whitespace=nowarn "$patch_file" \
            || die "parallel patch for $target no longer applies: $patch_file"
        git -C "$PHP_SRC_DIR" apply --index --whitespace=nowarn "$patch_file"
        ensure_changes_are_within_target "$target"

        if git -C "$PHP_SRC_DIR" diff --cached --quiet; then
            printf 'No staged changes for %s; no commit created.\n' "$target"
            continue
        fi

        subject="$target: $COMMIT_SUFFIX"
        git -C "$PHP_SRC_DIR" commit -m "$subject"
    done
}

print_parallel_failures() {
    local result_file
    local status
    local target
    local patch_file
    local log_file

    while IFS= read -r result_file; do
        IFS=$'\t' read -r status target patch_file log_file < "$result_file"
        [[ "$status" == failed ]] || continue

        printf '\n==> %s failed\n' "$target" >&2
        cat "$log_file" >&2 || true
    done < <(find "$WORKTREE_ROOT/results" -mindepth 1 -maxdepth 1 -type f | sort)
}

parallel_jobs() {
    local jobs
    jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"

    if [[ "$jobs" =~ ^[0-9]+$ && "$jobs" -gt 0 ]]; then
        printf '%s\n' "$jobs"
        return
    fi

    printf '4\n'
}

running_parallel_jobs() {
    jobs -rp | wc -l | tr -d '[:space:]'
}

target_slug() {
    local index="$1"
    local target="$2"
    local slug

    slug="$(printf '%s' "$target" | tr '/[:space:]' '___' | tr -cd 'A-Za-z0-9._-')"
    printf '%03d-%s\n' "$index" "$slug"
}

configure_test_runtime_for_parallel() {
    if [[ -x "${INTERNALS_CS_TEST_PHP_EXECUTABLE:-}" ]]; then
        return
    fi

    if [[ -x "$PHP_SRC_DIR/sapi/cli/php" ]]; then
        export INTERNALS_CS_TEST_PHP_EXECUTABLE="$PHP_SRC_DIR/sapi/cli/php"

        if [[ -x "$PHP_SRC_DIR/sapi/cgi/php-cgi" ]]; then
            export INTERNALS_CS_TEST_PHP_CGI_EXECUTABLE="$PHP_SRC_DIR/sapi/cgi/php-cgi"
        fi

        return
    fi

    if [[ -x "$TOOL_ROOT/var/php-test-runtime/php" ]]; then
        export INTERNALS_CS_TEST_PHP_EXECUTABLE="$TOOL_ROOT/var/php-test-runtime/php"

        if [[ -x "$TOOL_ROOT/var/php-test-runtime/php-cgi" ]]; then
            export INTERNALS_CS_TEST_PHP_CGI_EXECUTABLE="$TOOL_ROOT/var/php-test-runtime/php-cgi"
        fi
    fi
}

has_tracked_changes() {
    ! git -C "$PHP_SRC_DIR" diff --quiet || ! git -C "$PHP_SRC_DIR" diff --cached --quiet
}

ensure_changes_are_within_target() {
    ensure_changes_are_within_target_in_dir "$PHP_SRC_DIR" "$1" \
        || die "fixer changed a path outside current target $1"
}

ensure_changes_are_within_target_in_dir() {
    local php_src_dir="$1"
    local target="$2"
    local path

    while IFS= read -r path; do
        [[ -z "$path" ]] && continue

        if [[ "$path" != "$target" && "$path" != "$target/"* ]]; then
            git -C "$php_src_dir" status --short --untracked-files=no >&2
            printf 'fixer changed a path outside current target %s: %s\n' "$target" "$path" >&2
            return 1
        fi
    done < <(git -C "$php_src_dir" diff --name-only && git -C "$php_src_dir" diff --cached --name-only)
}

reset_generated_commits() {
    ensure_tracked_clean

    local count=0
    local ref='HEAD'
    local subject
    local commits=()

    while subject="$(git -C "$PHP_SRC_DIR" log -1 --format=%s "$ref" 2>/dev/null)"; do
        [[ "$subject" == *": $COMMIT_SUFFIX" ]] || break
        commits+=("$(git -C "$PHP_SRC_DIR" log -1 --format='%h %s' "$ref")")
        count=$((count + 1))
        ref="HEAD~$count"
    done

    if (( count == 0 )); then
        printf 'No generated commits at HEAD to reset.\n'
        return
    fi

    printf 'Generated commits to reset:\n'
    printf '  %s\n' "${commits[@]}"
    printf 'Type "nah %d" to run git reset --hard HEAD~%d: ' "$count" "$count"

    local answer
    IFS= read -r answer
    [[ "$answer" == "nah $count" ]] || die 'reset confirmation did not match'

    git -C "$PHP_SRC_DIR" reset --hard "HEAD~$count"
}

after_local_changes() {
    local mode="$1"
    local body_file
    body_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-body.XXXXXX")"

    generate_pr_body "$body_file"

    if (( DRY )); then
        preview_pr_description "$body_file"
        return
    fi

    if (( LFG )); then
        push_branch "$mode"
        update_pr_description "$body_file"
    else
        printf '\n--lfg not passed; skipped push and PR edit.\n'
        printf 'PR body preview: %s\n' "$body_file"
    fi
}

preview_pr_description() {
    local body_file="$1"

    if (( ! LFG )); then
        printf '\n--dry passed without --lfg; showing generated PR body block only.\n'
        printf 'Generated PR body block: %s\n\n' "$body_file"
        cat "$body_file"
        return
    fi

    command -v gh >/dev/null 2>&1 || die 'gh is required for --lfg --dry PR body preview'

    local current_file
    local merged_file
    current_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-current.XXXXXX")"
    merged_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-dry.XXXXXX")"

    if ! resolve_existing_pr_context; then
        write_new_pr_body "$body_file" "$merged_file"
        printf '\n--dry passed; skipped push and PR creation.\n'
        printf 'No open PR found for the current branch.\n'
        printf 'Draft PR body preview: %s\n\n' "$merged_file"
        cat "$merged_file"
        return
    fi

    fetch_pr_body "$current_file"
    merge_pr_body "$current_file" "$body_file" "$merged_file"

    printf '\n--dry passed; skipped push and PR edit.\n'
    print_pr_base_change_preview
    printf 'Unrendered merged PR body preview: %s\n\n' "$merged_file"
    cat "$merged_file"
}

push_branch() {
    local mode="$1"
    local branch
    branch="$(git -C "$PHP_SRC_DIR" branch --show-current)"
    PUSH_REMOTE="$(resolve_push_remote)"

    if [[ "$mode" == reset ]]; then
        git -C "$PHP_SRC_DIR" push --force-with-lease "$PUSH_REMOTE" "$branch"
        return
    fi

    local remote_ref="$PUSH_REMOTE/$branch"
    if git -C "$PHP_SRC_DIR" rev-parse --verify --quiet "$remote_ref^{commit}" >/dev/null; then
        local local_only
        local remote_only
        read -r local_only remote_only < <(
            git -C "$PHP_SRC_DIR" rev-list --left-right --count "HEAD...$remote_ref"
        )

        if (( remote_only > 0 && local_only == 0 )); then
            die "local branch is behind $remote_ref; refusing to push"
        fi

        if (( local_only > 0 && remote_only > 0 )); then
            printf 'Branch diverged from %s; pushing with --force-with-lease.\n' "$remote_ref"
            git -C "$PHP_SRC_DIR" push --force-with-lease "$PUSH_REMOTE" "$branch"
            return
        fi
    fi

    git -C "$PHP_SRC_DIR" push "$PUSH_REMOTE" "$branch"
}

update_pr_description() {
    local body_file="$1"
    command -v gh >/dev/null 2>&1 || die 'gh is required for --lfg PR editing'

    local current_file
    local merged_file
    current_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-current.XXXXXX")"
    merged_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-merged.XXXXXX")"

    if ! resolve_existing_pr_context; then
        create_draft_pr "$body_file"
        return
    fi

    fetch_pr_body "$current_file"
    merge_pr_body "$current_file" "$body_file" "$merged_file"
    sync_pr_base_if_needed
    update_pr_body "$merged_file"
}

write_new_pr_body() {
    local generated_file="$1"
    local output_file="$2"

    {
        printf '<!-- pr:targets:start -->\n'
        cat "$generated_file"
        printf '<!-- pr:targets:end -->\n'
    } > "$output_file"
}

create_draft_pr() {
    local body_file="$1"
    local branch
    local body_with_markers
    local head_owner
    local pr_url

    branch="$(current_branch)"
    body_with_markers="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-pr-create.XXXXXX")"
    write_new_pr_body "$body_file" "$body_with_markers"

    resolve_base_context
    PR_REPO="$(infer_pr_repo)"
    [[ -n "$PUSH_REMOTE" ]] || PUSH_REMOTE="$(resolve_push_remote)"
    head_owner="$(remote_owner "$PUSH_REMOTE")" \
        || die "cannot infer GitHub owner from push remote: $PUSH_REMOTE"

    pr_url="$(
        cd -- "$PHP_SRC_DIR" || exit 1
        gh pr create \
            --repo "$PR_REPO" \
            --head "$head_owner:$branch" \
            --base "$RESOLVED_BASE_NAME" \
            --title "$DEFAULT_PR_TITLE" \
            --body-file "$body_with_markers" \
            --draft
    )"

    printf 'Created draft PR: %s\n' "$pr_url"
}

merge_pr_body() {
    local current_file="$1"
    local generated_file="$2"
    local output_file="$3"
    local start='<!-- pr:targets:start -->'
    local end='<!-- pr:targets:end -->'

    grep -Fq "$start" "$current_file" \
        || die "PR body does not contain target table start marker: $start"

    grep -Fq "$end" "$current_file" \
        || die "PR body does not contain target table end marker: $end"

    awk -v start="$start" -v end="$end" -v generated="$generated_file" '
        {
            comparable = $0
            sub(/\r$/, "", comparable)
        }
        comparable == start {
            print
            while ((getline line < generated) > 0) print line
            in_block = 1
            next
        }
        comparable == end {
            print
            in_block = 0
            next
        }
        !in_block { print }
    ' "$current_file" > "$output_file"
}

write_pr_generation_provenance() {
    local run_url
    if ! run_url="$(github_actions_run_url)"; then
        return 0
    fi

    printf 'Generated by [Reproduce php-src PR](%s).\n' "$run_url"

    local tool_commit_url
    if tool_commit_url="$(github_actions_tool_commit_url)"; then
        printf 'Tool commit: [%s](%s).\n' "${GITHUB_SHA:0:12}" "$tool_commit_url"
    fi

    printf '\n'
}

github_actions_run_url() {
    [[ -n "${GITHUB_SERVER_URL:-}" ]] || return 1
    [[ -n "${GITHUB_REPOSITORY:-}" ]] || return 1
    [[ -n "${GITHUB_RUN_ID:-}" ]] || return 1

    printf '%s/%s/actions/runs/%s\n' "$GITHUB_SERVER_URL" "$GITHUB_REPOSITORY" "$GITHUB_RUN_ID"
}

github_actions_tool_commit_url() {
    [[ -n "${GITHUB_SERVER_URL:-}" ]] || return 1
    [[ -n "${GITHUB_REPOSITORY:-}" ]] || return 1
    [[ -n "${GITHUB_SHA:-}" ]] || return 1

    printf '%s/%s/commit/%s\n' "$GITHUB_SERVER_URL" "$GITHUB_REPOSITORY" "$GITHUB_SHA"
}

generate_pr_body() {
    local output_file="$1"
    resolve_base_context

    local commits_file
    local extracted_prs_file
    commits_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-commits.XXXXXX")"
    extracted_prs_file="$(mktemp "${TMPDIR:-/tmp}/php-src-cs-extracted-prs.XXXXXX")"
    git -C "$PHP_SRC_DIR" log --reverse --format='%H%x09%s' "$RESOLVED_BASE_REF..HEAD" > "$commits_file"

    discover_extracted_prs "$extracted_prs_file"

    local targets=()
    local target

    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        targets+=("$target")
    done < <(pending_targets "$commits_file" "$extracted_prs_file")

    ((${#targets[@]})) || die "no generated target commits found between $RESOLVED_BASE_REF and HEAD"

    {
        write_pr_generation_provenance
        printf '### Pending Targets (%d)\n\n' "${#targets[@]}"
        printf '| Target | Commit | Files | Extraction PR |\n'
        printf '|---|---|---:|---|\n'

        for target in "${targets[@]}"; do
            printf '| %s | %s | %s | %s |\n' \
                "$target" \
                "$(commit_cell_for_target "$target" "$commits_file")" \
                "$(affected_files_cell_for_target "$target" "$commits_file")" \
                "$(pending_pr_cell_for_target "$target" "$extracted_prs_file")"
        done

        write_merged_pr_table "$extracted_prs_file"
    } > "$output_file"
}

discover_extracted_prs() {
    local output_file="$1"
    : > "$output_file"

    if ! command -v gh >/dev/null 2>&1; then
        printf 'warning: gh is unavailable; extraction PR status will be omitted\n' >&2
        return
    fi

    if ! resolve_existing_pr_context; then
        printf 'No open container PR found; extraction PR status will be omitted.\n' >&2
        return
    fi

    local container_url="https://github.com/$PR_REPO/pull/$PR_NUMBER"
    local number
    local state
    local merged_at
    local title
    local title_lower
    local pr_state
    local target
    local candidates
    local targets

    candidates="$(
        {
            extracted_pr_candidates "\"$container_url\" repo:$PR_REPO is:pr"
            extracted_pr_candidates "\"$COMMIT_SUFFIX\" in:title repo:$PR_REPO is:pr"
            additional_extraction_pr_candidates
        } | LC_ALL=C sort -t $'\t' -k1,1n -u
    )" || die 'could not discover extraction PRs'

    while IFS=$'\t' read -r number state merged_at title; do
        [[ -n "$number" ]] || continue

        title_lower="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')"
        if [[ "$title_lower" != *"$COMMIT_SUFFIX"* ]] \
            && ! is_additional_extraction_pr "$number"; then
            continue
        fi

        if [[ "$state" == open ]]; then
            pr_state=open
        elif [[ "$merged_at" != - ]]; then
            pr_state=merged
        elif closed_pr_landed_on_base "$number" "$title"; then
            pr_state=landed
        else
            continue
        fi

        targets="$(extracted_pr_targets "$number" | LC_ALL=C sort -u)" \
            || die "could not inspect extraction PR #$number"
        while IFS= read -r target; do
            [[ -n "$target" ]] || continue
            printf '%s\t%s\t%s\n' "$target" "$pr_state" "$number" >> "$output_file"
        done <<< "$targets"
    done <<< "$candidates"

    LC_ALL=C sort \
        -t $'\t' \
        -k1,1 \
        -k2,2 \
        -k3,3n \
        -u \
        -o "$output_file" \
        "$output_file"
}

extracted_pr_candidates() {
    local query="$1"

    gh api \
        --paginate \
        --method GET \
        search/issues \
        -f "q=$query" \
        -f per_page=100 \
        --jq '.items[] | [.number, .state, (.pull_request.merged_at // "-"), .title] | @tsv'
}

additional_extraction_pr_candidates() {
    local number

    for number in "${ADDITIONAL_EXTRACTION_PRS[@]}"; do
        gh api \
            --method GET \
            "repos/$PR_REPO/pulls/$number" \
            --jq '[.number, .state, (.merged_at // "-"), .title] | @tsv'
    done
}

is_additional_extraction_pr() {
    local wanted="$1"
    local number

    for number in "${ADDITIONAL_EXTRACTION_PRS[@]}"; do
        [[ "$number" == "$wanted" ]] && return 0
    done

    return 1
}

closed_pr_landed_on_base() {
    local pr_number="$1"
    local title="$2"
    local pr_patch_id
    local hash
    local subject
    local commit_patch_id

    pr_patch_id="$(
        gh api \
            -H 'Accept: application/vnd.github.v3.diff' \
            "repos/$PR_REPO/pulls/$pr_number" \
            | git patch-id --stable \
            | awk 'NR == 1 { print $1 }'
    )" || return 1
    [[ -n "$pr_patch_id" ]] || return 1

    while IFS=$'\t' read -r hash subject; do
        [[ "$subject" == "$title" ]] || continue

        commit_patch_id="$(
            git -C "$PHP_SRC_DIR" show --pretty=email --no-ext-diff "$hash" \
                | git patch-id --stable \
                | awk 'NR == 1 { print $1 }'
        )"

        [[ "$commit_patch_id" == "$pr_patch_id" ]] && return 0
    done < <(
        git -C "$PHP_SRC_DIR" log \
            --fixed-strings \
            --grep="$title" \
            --format='%H%x09%s' \
            "$RESOLVED_BASE_REF"
    )

    return 1
}

extracted_pr_targets() {
    local pr_number="$1"

    # $parts is a jq variable.
    # shellcheck disable=SC2016
    gh api \
        --paginate \
        --method GET \
        "repos/$PR_REPO/pulls/$pr_number/files" \
        -f per_page=100 \
        --jq '.[] | .filename | split("/") as $parts |
            if ($parts[0] == "ext" or $parts[0] == "sapi") and ($parts | length) > 2 then
                $parts[0:2] | join("/")
            elif $parts[0] == "Zend" then "Zend"
            elif $parts[0] == "tests" then "tests"
            else empty
            end'
}

pending_pr_cell_for_target() {
    local target="$1"
    local extracted_prs_file="$2"
    local refs

    refs="$(pr_refs_for_target "$target" "$extracted_prs_file" open)"
    printf '%s' "${refs:-Pending}"
}

write_merged_pr_table() {
    local extracted_prs_file="$1"
    local targets=()
    local target
    local refs
    local merged_count

    while IFS= read -r target; do
        [[ -n "$target" ]] && targets+=("$target")
    done < <(
        awk -F $'\t' '$2 == "merged" || $2 == "landed" { print $1 }' "$extracted_prs_file" \
            | LC_ALL=C sort -u
    )

    merged_count="${#targets[@]}"
    (( merged_count )) || return 0

    printf '\n### Merged Targets (%s)\n\n' "$merged_count"
    printf '| Target | Merged / landed PR |\n'
    printf '|---|---|\n'

    for target in "${targets[@]}"; do
        refs="$(pr_refs_for_target "$target" "$extracted_prs_file" merged landed)"
        printf '| %s | %s |\n' "$target" "$refs"
    done
}

pr_refs_for_target() {
    local wanted_target="$1"
    local extracted_prs_file="$2"
    shift 2

    local wanted_state
    local target
    local state
    local number
    local separator=''

    for wanted_state in "$@"; do
        while IFS=$'\t' read -r target state number; do
            [[ "$target" == "$wanted_target" && "$state" == "$wanted_state" ]] || continue
            printf '%s#%s' "$separator" "$number"
            [[ "$state" == landed ]] && printf ' (cherry-picked)'
            separator=', '
        done < "$extracted_prs_file"
    done
}

resolve_base_context() {
    if [[ -n "$RESOLVED_BASE_REF" ]]; then
        return
    fi

    if [[ -n "$PR_NUMBER" && -n "$PR_REPO" && -z "$RESOLVED_BASE_NAME" ]]; then
        resolve_existing_pr_context || true
    fi

    local base_ref
    if [[ -z "$RESOLVED_BASE_NAME" ]]; then
        if base_ref="$(infer_local_base_ref)"; then
            printf 'detected base: %s\n' "$base_ref" >&2
            RESOLVED_BASE_REF="$base_ref"
            RESOLVED_BASE_NAME="$(base_name_from_ref "$base_ref")"
            return
        fi

        resolve_existing_pr_context || true
    fi

    if [[ -n "$RESOLVED_BASE_NAME" ]]; then
        if base_ref="$(base_name_to_local_ref "$RESOLVED_BASE_NAME")"; then
            printf 'detected base: %s\n' "$base_ref" >&2
            RESOLVED_BASE_REF="$base_ref"
            return
        fi

        die "base branch is not available locally: $RESOLVED_BASE_NAME"
    fi

    RESOLVED_BASE_REF="$(prompt_for_base_ref)"
    RESOLVED_BASE_NAME="$(base_name_from_ref "$RESOLVED_BASE_REF")"
}

infer_local_base_ref() {
    local candidate
    local head

    head="$(git -C "$PHP_SRC_DIR" rev-parse HEAD)" || return 1

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        ref_exists "$candidate" || continue
        git -C "$PHP_SRC_DIR" merge-base --is-ancestor "$candidate" "$head" || continue

        printf '%s\n' "$candidate"
        return
    done < <(base_ref_candidates)

    return 1
}

ref_exists() {
    git -C "$PHP_SRC_DIR" rev-parse --verify --quiet "$1^{commit}" >/dev/null
}

resolve_existing_pr_context() {
    if [[ -n "$PR_NUMBER" && -n "$PR_REPO" ]]; then
        if [[ -n "$EXISTING_PR_BASE_NAME" ]]; then
            return
        fi

        local explicit_line
        explicit_line="$(
            gh pr view "$PR_NUMBER" \
                --repo "$PR_REPO" \
                --json number,url,baseRefName \
                --jq '[.url, (.number|tostring), .baseRefName] | @tsv'
        )" || return 1

        populate_pr_context "$explicit_line"
        return
    fi

    command -v gh >/dev/null 2>&1 || return 1

    local line
    if line="$(
        cd -- "$PHP_SRC_DIR" || exit 1
        gh pr view --json number,url,baseRefName \
            --jq '[.url, (.number|tostring), .baseRefName] | @tsv' \
            2>/dev/null
    )" && populate_pr_context "$line"; then
        return
    fi

    local branch
    branch="$(current_branch)" || return 1

    PR_REPO="${PR_REPO:-$(infer_pr_repo)}"

    local head_owner
    while IFS= read -r head_owner; do
        [[ -n "$head_owner" ]] || continue

        line="$(
            gh pr list \
                --repo "$PR_REPO" \
                --head "$head_owner:$branch" \
                --state open \
                --json number,url,baseRefName \
                --jq '.[0] | select(. != null) | [.url, (.number|tostring), .baseRefName] | @tsv' \
                2>/dev/null
        )" || continue

        if populate_pr_context "$line"; then
            return
        fi
    done < <(head_owners)

    return 1
}

populate_pr_context() {
    local line="$1"
    local url
    local number
    local base_name

    IFS=$'\t' read -r url number base_name <<< "$line"

    [[ -n "$url" && -n "$number" && "$number" != null ]] || return 1

    PR_NUMBER="$number"
    PR_REPO="$(github_repo_from_pr_url "$url")" || return 1

    if [[ -n "$base_name" && "$base_name" != null ]]; then
        EXISTING_PR_BASE_NAME="$base_name"
    fi

    if [[ -z "$RESOLVED_BASE_NAME" && -n "$base_name" && "$base_name" != null ]]; then
        RESOLVED_BASE_NAME="$base_name"
    fi

    return 0
}

print_pr_base_change_preview() {
    if [[ -z "$EXISTING_PR_BASE_NAME" || -z "$RESOLVED_BASE_NAME" ]]; then
        return
    fi

    if [[ "$EXISTING_PR_BASE_NAME" == "$RESOLVED_BASE_NAME" ]]; then
        return
    fi

    printf 'PR base would change: %s -> %s\n' "$EXISTING_PR_BASE_NAME" "$RESOLVED_BASE_NAME"
}

sync_pr_base_if_needed() {
    if [[ -z "$EXISTING_PR_BASE_NAME" || -z "$RESOLVED_BASE_NAME" ]]; then
        return
    fi

    if [[ "$EXISTING_PR_BASE_NAME" == "$RESOLVED_BASE_NAME" ]]; then
        return
    fi

    gh api \
        --method PATCH \
        "repos/$PR_REPO/pulls/$PR_NUMBER" \
        -f "base=$RESOLVED_BASE_NAME" \
        --silent
}

update_pr_body() {
    local body_file="$1"

    gh api \
        --method PATCH \
        "repos/$PR_REPO/pulls/$PR_NUMBER" \
        -F "body=@$body_file" \
        --silent
}

fetch_pr_body() {
    local output_file="$1"

    gh api "repos/$PR_REPO/pulls/$PR_NUMBER" --jq '.body // ""' > "$output_file"
}

infer_pr_repo() {
    if [[ -n "$PR_REPO" ]]; then
        printf '%s\n' "$PR_REPO"
        return
    fi

    local repo
    if repo="$(remote_repo upstream 2>/dev/null)"; then
        printf '%s\n' "$repo"
        return
    fi

    printf '%s\n' "$DEFAULT_PR_REPO"
}

resolve_push_remote() {
    local candidate
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if remote_exists "$candidate"; then
            printf '%s\n' "$candidate"
            return
        fi
    done < <(
        branch_push_remote || true
        git -C "$PHP_SRC_DIR" config remote.pushDefault 2>/dev/null || true
        printf 'origin\n'
        branch_upstream_remote || true
    )

    local remotes=()
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] && remotes+=("$candidate")
    done < <(git -C "$PHP_SRC_DIR" remote)

    if ((${#remotes[@]} == 1)); then
        printf '%s\n' "${remotes[0]}"
        return
    fi

    die 'cannot determine push remote; configure a branch push remote'
}

head_owners() {
    local remote
    local owner
    local seen=' '

    while IFS= read -r remote; do
        [[ -n "$remote" ]] || continue

        if owner="$(remote_owner "$remote" 2>/dev/null)" && [[ "$seen" != *" $owner "* ]]; then
            printf '%s\n' "$owner"
            seen+="$owner "
        fi
    done < <(
        branch_push_remote || true
        branch_upstream_remote || true
        printf 'origin\n'
        git -C "$PHP_SRC_DIR" remote
    )
}

branch_push_remote() {
    local branch
    branch="$(current_branch)" || return 1
    git -C "$PHP_SRC_DIR" config "branch.$branch.pushRemote"
}

branch_upstream_remote() {
    local upstream
    upstream="$(git -C "$PHP_SRC_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || return 1
    [[ "$upstream" == */* ]] || return 1
    printf '%s\n' "${upstream%%/*}"
}

current_branch() {
    git -C "$PHP_SRC_DIR" branch --show-current
}

remote_exists() {
    git -C "$PHP_SRC_DIR" remote get-url "$1" >/dev/null 2>&1
}

remote_owner() {
    local repo
    repo="$(remote_repo "$1")" || return 1
    printf '%s\n' "${repo%%/*}"
}

remote_repo() {
    local remote="$1"
    local url
    url="$(git -C "$PHP_SRC_DIR" remote get-url "$remote" 2>/dev/null)" || return 1
    github_repo_from_remote_url "$url"
}

github_repo_from_pr_url() {
    local rest="${1#https://github.com/}"
    [[ "$rest" != "$1" && "$rest" == */*/pull/* ]] || return 1

    local owner="${rest%%/*}"
    rest="${rest#*/}"
    local repo="${rest%%/*}"

    [[ -n "$owner" && -n "$repo" ]] || return 1
    printf '%s/%s\n' "$owner" "$repo"
}

github_repo_from_remote_url() {
    local url="$1"
    local path

    case "$url" in
        git@github.com:*)
            path="${url#git@github.com:}"
            ;;
        ssh://git@github.com/*)
            path="${url#ssh://git@github.com/}"
            ;;
        https://github.com/*)
            path="${url#https://github.com/}"
            ;;
        http://github.com/*)
            path="${url#http://github.com/}"
            ;;
        *)
            return 1
            ;;
    esac

    local owner="${path%%/*}"
    path="${path#*/}"
    local repo="${path%%/*}"
    repo="${repo%.git}"

    [[ -n "$owner" && -n "$repo" ]] || return 1
    printf '%s/%s\n' "$owner" "$repo"
}

base_name_to_local_ref() {
    local base_name="$1"
    local candidate

    for candidate in "upstream/$base_name" "origin/$base_name" "$base_name"; do
        if ref_exists "$candidate"; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    return 1
}

base_name_from_ref() {
    local ref="$1"

    case "$ref" in
        refs/remotes/*/*)
            ref="${ref#refs/remotes/}"
            printf '%s\n' "${ref#*/}"
            ;;
        refs/heads/*)
            printf '%s\n' "${ref#refs/heads/}"
            ;;
        */*)
            printf '%s\n' "${ref#*/}"
            ;;
        *)
            printf '%s\n' "$ref"
            ;;
    esac
}

prompt_for_base_ref() {
    local candidates=()
    local candidate

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        ref_exists "$candidate" || continue

        local existing
        local duplicate=0
        for existing in ${candidates[@]+"${candidates[@]}"}; do
            if [[ "$existing" == "$candidate" ]]; then
                duplicate=1
                break
            fi
        done

        (( duplicate )) || candidates+=("$candidate")
    done < <(base_ref_candidates)

    ((${#candidates[@]})) || die 'cannot determine base ref'

    printf 'No associated PR base found. Select base ref:\n' >&2

    local index
    for index in "${!candidates[@]}"; do
        printf '  %d) %s\n' "$((index + 1))" "${candidates[$index]}" >&2
    done

    printf 'Base [1-%d]: ' "${#candidates[@]}" >&2

    local answer
    IFS= read -r answer || die 'base selection cancelled'

    [[ "$answer" =~ ^[0-9]+$ ]] || die 'base selection must be a number'
    (( answer >= 1 && answer <= ${#candidates[@]} )) || die 'base selection out of range'

    printf '%s\n' "${candidates[$((answer - 1))]}"
}

base_ref_candidates() {
    printf '%s\n' \
        upstream/master \
        upstream/main \
        upstream/PHP-8.5 \
        upstream/PHP-8.4 \
        upstream/PHP-8.3 \
        origin/master \
        origin/main \
        origin/PHP-8.5 \
        origin/PHP-8.4 \
        origin/PHP-8.3 \
        master \
        main \
        PHP-8.5 \
        PHP-8.4 \
        PHP-8.3

    git -C "$PHP_SRC_DIR" for-each-ref \
        --format='%(refname:short)' \
        refs/remotes/upstream \
        refs/remotes/origin \
        refs/heads \
        2>/dev/null \
        | while IFS= read -r candidate; do
            is_base_candidate "$candidate" && printf '%s\n' "$candidate"
        done
}

is_base_candidate() {
    case "$1" in
        upstream/master|upstream/main|origin/master|origin/main|master|main)
            return 0
            ;;
    esac

    [[ "$1" =~ ^(upstream/|origin/)?(PHP-8\.([3-9]|[1-9][0-9]+)|PHP-([9]|[1-9][0-9]+)\.[0-9]+)$ ]]
}

committed_targets() {
    local commits_file="$1"
    local suffix=": $COMMIT_SUFFIX"

    awk -F $'\t' -v suffix="$suffix" '
        {
            subject = $2
            suffix_start = length(subject) - length(suffix) + 1
            if (suffix_start < 1 || substr(subject, suffix_start) != suffix) {
                next
            }

            target = substr(subject, 1, suffix_start - 1)
            if (!seen[target]++) {
                print target
            }
        }
    ' "$commits_file"
}

pending_targets() {
    local commits_file="$1"
    local extracted_prs_file="$2"

    {
        committed_targets "$commits_file"
        awk -F $'\t' '$2 == "open" { print $1 }' "$extracted_prs_file"
    } | LC_ALL=C sort -f -u
}

commit_cell_for_target() {
    local target="$1"
    local commits_file="$2"
    local hash
    local separator=''
    local found=0

    while IFS= read -r hash; do
        [[ -n "$hash" ]] || continue
        printf '%s%s' "$separator" "${hash:0:12}"
        separator=', '
        found=1
    done < <(commit_hashes_for_target "$target" "$commits_file")

    (( found )) || printf '—'
}

affected_files_cell_for_target() {
    local target="$1"
    local commits_file="$2"

    local hashes=()
    local hash

    while IFS= read -r hash; do
        [[ -n "$hash" ]] && hashes+=("$hash")
    done < <(commit_hashes_for_target "$target" "$commits_file")

    if ((${#hashes[@]} == 0)); then
        printf '—'
        return
    fi

    for hash in "${hashes[@]}"; do
        git -C "$PHP_SRC_DIR" diff-tree --no-commit-id --name-only -r "$hash" --
    done \
        | LC_ALL=C sort -u \
        | wc -l \
        | tr -d '[:space:]'
}

commit_hashes_for_target() {
    local target="$1"
    local commits_file="$2"
    local hash subject
    local found=0

    while IFS=$'\t' read -r hash subject; do
        if [[ "$subject" == "$target: $COMMIT_SUFFIX" ]]; then
            printf '%s\n' "$hash"
            found=1
        fi
    done < "$commits_file"

    (( found ))
}

main "$@"
